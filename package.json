{
  "name": "catawiki-qa-automation-assignment",
  "version": "0.0.0",
  "private": true,
  "description": "Risk-based Playwright and TypeScript QA automation for Catawiki's read-only buyer journey",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test --project=unit",
    "test:fixture-contracts": "playwright test --project=fixture-contracts",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "test:mobile": "playwright test --project=mobile-chromium",
    "test:regression": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "eslint": "10.8.1",
    "eslint-plugin-playwright": "2.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
